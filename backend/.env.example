APP_NAME=GreenFab Loop API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://greenfab:change-me@localhost:5432/greenfab
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DEMO_MODE=true
SEED_DEMO_DATA=true
DEMO_RESET_ENABLED=false
CORS_ORIGINS=["http://localhost:5173"]
AUTH_MODE=demo
API_KEY_CREDENTIALS=[]
DEMO_ACTOR=demo_operator
EVIDENCE_STORAGE_ROOT=var/evidence
EVIDENCE_MAX_BYTES=5242880
DETECT_ARTIFACT_MAX_BYTES=20971520

# Default stays offline and deterministic. Set bge_chroma explicitly to run
# real BAAI/bge-m3 inference; the server never falls back to Mock silently.
MATCH_PROVIDER=mock
INSTALL_MATCH_RUNTIME=false
BGE_MODEL_NAME=BAAI/bge-m3
BGE_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
BGE_DEVICE=cpu
BGE_BATCH_SIZE=4
CHROMA_MODE=persistent
CHROMA_COLLECTION_NAME=greenfab_demands
CHROMA_PERSIST_DIRECTORY=.data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_HEADERS={}
DEMAND_INDEX_SYNC_ON_STARTUP=true
CHROMA_EXTERNAL_PORT=8001

POSTGRES_DB=greenfab
POSTGRES_USER=greenfab
POSTGRES_PASSWORD=change-me
